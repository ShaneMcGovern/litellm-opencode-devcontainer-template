# Copy this file to .env, which git ignores, and fill it in:
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# Neither value may be empty. A blank name fails every commit with
# "fatal: empty ident name", and a blank email records an empty author email.
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# Uncomment the keys you use, and leave the rest commented out, not blank.
# Set both keys if you can. The default model, deepseek-v4-pro, falls back
# to claude-opus when a request fails, and that needs the Anthropic key.
# Recreate the container after a change:
#
#   docker compose -f .devcontainer/compose.yaml up -d --force-recreate

# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
# If another tool keeps this key as ANTHROPIC_AUTH_TOKEN, copy the value here.
# Never add ANTHROPIC_AUTH_TOKEN or ANTHROPIC_BASE_URL to this file or to
# compose.yaml. LiteLLM reads both for its Claude models, so requests or keys
# would go to the wrong vendor.
# DEEPSEEK_API_KEY=

# These matter only on Linux hosts where your uid is not 1000. Uncomment
# them, set them to your `id -u` and `id -g`, then rebuild:
#
#   docker compose -f .devcontainer/compose.yaml up -d --build
# USER_UID=1000
# USER_GID=1000
