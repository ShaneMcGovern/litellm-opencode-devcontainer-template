{
  // Setup lives in entrypoint.sh, so plain `docker compose up` works too.
  "name": "litellm-opencode-devcontainer-template",

  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/app",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python",
        // Use the mypy in .venv, so it matches pre-commit and CI.
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "python.testing.pytestEnabled": true,
        // Coverage tracing makes the debugger skip breakpoints.
        "python.testing.pytestArgs": ["--no-cov"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  },

  // Keep the LiteLLM proxy inside the container.
  "portsAttributes": {
    "4000": { "onAutoForward": "ignore" }
  },

  "remoteUser": "developer"
}
